# Vorlage für die lokale .env-Datei (cp .env.example .env).
# Echte Schlüssel gehören NUR in .env (lokal) bzw. in die Render-Einstellungen, nie in den Code.

# Google-Gemini-Schlüssel für den PDF-/Screenshot-Import (optional, ohne ihn gehen CSV und Excel trotzdem)
GEMINI_API_KEY=
# Optional: anderes Gemini-Modell (Standard: gemini-3.5-flash-lite)
# GEMINI_MODEL=
# Optional: Ersatzmodell, wenn das erste überlastet ist (Standard: gemini-3.1-flash-lite, "-" = keins)
# GEMINI_FALLBACK_MODEL=
